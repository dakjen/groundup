{
  "rewrites": [
    {
      "source": "/waitlist",
      "destination": "/api/waitlist-page"
    },
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/broadcast",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/broadcast",
      "schedule": "0 4 1 11 *"
    },
    {
      "path": "/api/broadcast",
      "schedule": "6 4 1 11 *"
    },
    {
      "path": "/api/broadcast",
      "schedule": "0 5 1 12 *"
    },
    {
      "path": "/api/broadcast",
      "schedule": "6 5 1 12 *"
    },
    {
      "path": "/api/broadcast?foundingwelcome=1",
      "schedule": "0 14 14 11 *"
    },
    {
      "path": "/api/broadcast?foundingdaily=1",
      "schedule": "0 18 14-20 11 *"
    },
    {
      "path": "/api/broadcast?drip=1",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/stripe?reconcile=1",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/broadcast?report=1",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/broadcast?launchday=1",
      "schedule": "0 19 1 11 *"
    },
    {
      "path": "/api/broadcast?launchday=1",
      "schedule": "6 19 1 11 *"
    },
    {
      "path": "/api/broadcast?evening=1",
      "schedule": "0 3 2 11 *"
    },
    {
      "path": "/api/broadcast?evening=1",
      "schedule": "6 3 2 11 *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/broadcast.js": { "maxDuration": 60 },
    "api/waitlist.js": { "maxDuration": 60 },
    "api/lunchlearn.js": { "maxDuration": 60 },
    "api/retainers.js": { "maxDuration": 60 }
  },
  "buildCommand": "npm run build"
}
